---
import BaseLayout from "../layouts/BaseLayout.astro";

const caseStudies = [
  {
    title: "Building AI Agents That Give Delivery Teams Their Time Back",
    role: "Release Train Engineer & AI Agent Co-Creator - Accenture Federal Services",
    context: "Agentic AI for federal Agile delivery - GenAI.mil / Agent Arsenal Challenge",
    problem:
      "RTEs and Agile coaches on federal programs were losing thousands of hours a year to manual data consolidation, reporting, and backlog admin - an RTE alone spent ~17 hours a week on it. That overhead slowed decisions, raised delivery risk, and pulled scarce experts off mission-critical work.",
    actions: [
      "Co-designed and built two secure, mission-ready AI agents on GenAI.mil - the government's air-gapped, Gemini-powered platform - during Accenture's Agent Arsenal Challenge.",
      "Built an RTE Assistant and a Team Coach Assistant that automate SDLC administration: ceremony prep, reporting, dependency mapping, backlog refinement, and WSJF prioritization, with human-in-the-loop checkpoints.",
      "Integrated real-time delivery intelligence across Jira, ServiceNow, and Azure DevOps for live capacity, predictability, and proactive risk/dependency alerts.",
      "Our Army account produced two of the challenge's top-five finalists.",
    ],
    results: [
      "RTE Assistant: ~900 RTE hours a year redirected from admin to Agile leadership across 5 ARTs; program predictability lifted to 90-100%.",
      "Team Coach Assistant: ~2,000 coaching hours a year reclaimed per ART; Say/Do delivery predictability lifted to 90-100%.",
      "50% faster risk-and-dependency identification, catching schedule slips before they escalate.",
    ],
    stats: [
      { value: "Top 5", label: "Agent Arsenal finalist (2 of 5)" },
      { value: "900 hrs", label: "RTE hours reclaimed/yr (5 ARTs)" },
      { value: "2,000 hrs", label: "Coach hours reclaimed/yr per ART" },
      { value: "50%", label: "Faster risk/dependency ID" },
    ],
    tags: ["Generative AI", "Agentic AI", "SAFe", "GenAI.mil", "Federal Delivery"],
  },
  {
    title: "AI-Powered User Story Generator: From Three Questions to Sprint-Ready Stories",
    role: "Creator, Designer & Builder - Accenture Federal Services",
    context: "Low-code AI tooling for Agile backlog refinement - Power Apps + Power Automate",
    problem:
      "Writing well-formed user stories with clear acceptance criteria is slow, inconsistent work that pulls Product Owners and teams away from delivery. Story quality varied from author to author, and moving drafts into the backlog meant manual copy-and-paste.",
    actions: [
      "Designed and built a Power Apps canvas app that turns three plain-language inputs - who the user is, what they need, and why - plus optional context and acceptance notes into a complete AI-drafted user story.",
      "Wired the app to a Power Automate generation flow that returns a title, an \"As a / I want / So that\" story, and itemized acceptance criteria as structured JSON.",
      "Kept a human in the loop: every AI draft stays fully editable, and only reviewed stories can be added to the export queue.",
      "Built an in-session export queue and a second flow that exports reviewed stories to CSV for bulk backlog import, with input validation and a documented test procedure.",
    ],
    results: [
      "Reduced story authoring to three required inputs and a single click to generate a complete draft with acceptance criteria.",
      "Standardized story format and acceptance-criteria structure across authors.",
      "Replaced one-at-a-time copy-and-paste with batch CSV export of reviewed stories into the backlog.",
    ],
    stats: [
      { value: "3", label: "Inputs to a full story" },
      { value: "1-click", label: "AI draft + acceptance criteria" },
      { value: "100%", label: "Human-reviewed before export" },
      { value: "CSV", label: "Batch backlog export" },
    ],
    tags: ["Generative AI", "Power Apps", "Power Automate", "Low-Code", "Backlog Refinement"],
  },
  {
    title: "Cutting Feature Cycle Time from 99 to 70 Days",
    role: "Release Train Engineer - Accenture Federal Services",
    context: "Federal Enterprise Logistics - Agile Release Train of 7 teams",
    before: 99,
    after: 70,
    problem:
      "As RTE for an Agile Release Train of 7 cross-functional teams (4 Scrum, 3 Kanban) delivering a massive-scale federal logistics system, I owned flow across 10-week Program Increments - where feature cycle time had reached 99 days. Bottlenecks were stalling enterprise enhancements to systems that keep global supply-chain and logistics operations running.",
    actions: [
      "Instrumented the value stream to find the real bottlenecks, not the assumed ones.",
      "Re-engineered PI planning and cross-team dependency management to clear the pipeline.",
      "Synchronized delivery across mixed Scrum and Kanban cadences to protect throughput.",
      "Hardened the release path so enhancements shipped without disrupting live global operations.",
    ],
    results: [
      "Feature cycle time cut from 99 to 70 days - 29 days faster (~29%).",
      "Sustained 35 complex features per Program Increment across 7 teams.",
      "20 major enterprise enhancements deployed to production with zero disruption.",
    ],
    stats: [
      { value: "7", label: "Teams (4 Scrum, 3 Kanban)" },
      { value: "35", label: "Features / PI" },
      { value: "20", label: "Prod deployments" },
      { value: "0", label: "Disruptions" },
    ],
    tags: ["SAFe", "Release Train Engineering", "Process Optimization", "Federal Delivery"],
  },
  {
    title: "Standing Up SAFe from Scratch: 25% Efficiency Gain Across 5 PIs",
    role: "IT Project Manager - SAFe Transformation Lead & Scrum Master - Accenture Federal Services",
    context: "SAP Maintenance Business Area - 7-member cross-functional Scrum team",
    problem:
      "An SAP Maintenance business area was delivering without a scaled Agile framework - inconsistent cadence, unclear priorities, and no shared rhythm. I was brought in as the primary Agile transformation lead, partnering with the RTE and Enterprise Agile Lead, to stand up SAFe from the ground up.",
    actions: [
      "Led the foundational transition to the Scaled Agile Framework (SAFe) - establishing cadence, roles, and ceremonies from scratch.",
      "Engineered continuous-improvement frameworks and cleared critical bottlenecks across five Program Increments.",
      "Directed a 7-member cross-functional Scrum team through disciplined 10-day sprint cycles, managing the backlog in ServiceNow.",
      "Coached the team to a stable, predictable delivery rhythm aligned to enterprise maintenance goals.",
    ],
    results: [
      "Drove a 25% measurable increase in team efficiency over 5 Program Increments.",
      "Sustained a consistent velocity of 33 story points per sprint.",
      "Delivered 50 complex SAP features aligned with strategic enterprise maintenance goals.",
    ],
    stats: [
      { value: "+25%", label: "Team efficiency (5 PIs)" },
      { value: "33", label: "Story points / sprint" },
      { value: "50", label: "SAP features delivered" },
      { value: "7", label: "Scrum team members" },
    ],
    tags: ["SAFe", "Agile Transformation", "Scrum Master", "SAP", "Federal Delivery"],
  },
];
---

<BaseLayout title="Case Studies" description="Case studies from Seth Dow - enterprise Agile delivery, AI agents, and SAFe transformation">
  <div class="container">
    <header class="page-header">
      <h1>Case Studies</h1>
      <p>Deep dives into delivery outcomes - the problem, what I did, and the measurable result.</p>
    </header>

    <div class="cs-list">
      {caseStudies.map((cs) => (
        <article class="cs">
          <div class="cs-head">
            <h2>{cs.title}</h2>
            <p class="cs-role">{cs.role}</p>
            <p class="cs-context">{cs.context}</p>
          </div>

          {cs.before && (
            <div class="cs-visual">
              <div class="bar-row">
                <span class="bar-label">Before</span>
                <div class="bar bar-before"><span>{cs.before} days</span></div>
              </div>
              <div class="bar-row">
                <span class="bar-label">After</span>
                <div class="bar bar-after" style={`width:${(cs.after / cs.before) * 100}%`}><span>{cs.after} days</span></div>
              </div>
              <p class="delta">-{Math.round((1 - cs.after / cs.before) * 100)}% cycle time</p>
            </div>
          )}

          <div class="cs-stats">
            {cs.stats.map((s) => (
              <div class="stat">
                <span class="stat-value">{s.value}</span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))}
          </div>

          <div class="cs-body">
            <div class="cs-block">
              <h3>The problem</h3>
              <p>{cs.problem}</p>
            </div>
            <div class="cs-block">
              <h3>What I did</h3>
              <ul>{cs.actions.map((a) => <li>{a}</li>)}</ul>
            </div>
            <div class="cs-block">
              <h3>The result</h3>
              <ul>{cs.results.map((r) => <li>{r}</li>)}</ul>
            </div>
          </div>

          <div class="tag-row">
            {cs.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="cs-cta">
      <a href="/Portfolio/experience" class="btn-ghost">See full experience -></a>
    </div>
  </div>
</BaseLayout>

<style>
  .container { padding-top: 3rem; padding-bottom: 4rem; }
  .page-header { margin-bottom: 3rem; border-bottom: 1px solid var(--border); padding-bottom: 2rem; }
  .page-header h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .page-header p { color: var(--muted); font-size: 1rem; }
  .cs-list { display: flex; flex-direction: column; gap: 3rem; }
  .cs { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; }
  .cs-head h2 { font-size: 1.35rem; font-weight: 700; margin-bottom: 0.35rem; line-height: 1.3; }
  .cs-role { color: var(--accent); font-size: 0.85rem; font-weight: 600; }
  .cs-context { color: var(--muted); font-size: 0.82rem; margin-top: 0.15rem; }
  .cs-visual { margin: 1.75rem 0; }
  .bar-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.6rem; }
  .bar-label { width: 52px; color: var(--muted); font-size: 0.78rem; text-align: right; }
  .bar { height: 30px; border-radius: 5px; display: flex; align-items: center; min-width: 70px; }
  .bar span { padding: 0 0.6rem; font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
  .bar-before { width: 100%; background: var(--border); color: var(--muted); }
  .bar-after { background: var(--accent); color: #fff; }
  .delta { margin-top: 0.4rem; margin-left: 62px; color: var(--accent); font-weight: 700; font-size: 0.85rem; }
  .cs-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.75rem; margin: 1.5rem 0; }
  .stat { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 0.9rem; text-align: center; }
  .stat-value { display: block; font-size: 1.5rem; font-weight: 700; color: var(--accent); }
  .stat-label { color: var(--muted); font-size: 0.72rem; }
  .cs-body { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 0.5rem; }
  .cs-block h3 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.5rem; }
  .cs-block p { color: var(--text); font-size: 0.9rem; line-height: 1.7; }
  .cs-block ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .cs-block li { color: var(--text); font-size: 0.9rem; line-height: 1.6; padding-left: 1rem; position: relative; }
  .cs-block li::before { content: "-"; position: absolute; left: 0; color: var(--accent); }
  .tag-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .cs-cta { margin-top: 3rem; }
  .btn-ghost { display: inline-block; border: 1px solid var(--border); color: var(--text); border-radius: 6px; padding: 0.65rem 1.4rem; font-size: 0.9rem; font-weight: 500; transition: border-color 0.2s; }
  .btn-ghost:hover { border-color: var(--accent); }
  @media (max-width: 640px) { .cs { padding: 1.5rem; } }
</style>
